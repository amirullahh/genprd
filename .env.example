# Auth (npm run setup fills these into .env.local automatically)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=file:./data/app.db

# Optional: Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: server-wide LLM keys (fallback when the user hasn't set their own key in Settings)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# Claude (Anthropic) — not a free tier, only set this if you want to cover it for every user
ANTHROPIC_API_KEY=
# Set this only if Ollama is running locally:
# OLLAMA_BASE_URL=http://localhost:11434/v1
